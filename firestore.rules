rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email == 'ansarmedia@ansarschool.in';
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /campusBlocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
  }
}
